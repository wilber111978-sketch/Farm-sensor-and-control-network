# Copy to .env on FarmPi. Never commit the real .env file.
SOLAR_CAMERA_HOST=192.168.1.100
SOLAR_CAMERA_USER=admin
SOLAR_CAMERA_PASSWORD=
SOLAR_CAMERA_RTSP_PORT=554
SOLAR_CAMERA_HTTP_PORT=80
SOLAR_CAMERA_PROFILE=MainStream
SOLAR_CAMERA_PTZ_SPEED=0.55

HYDRAWISE_USERNAME=
HYDRAWISE_API_KEY=
HYDRAWISE_CONTROLLER_ID=

# Set the exact WGS84 coordinates only in the private .env on FarmPi.
# Do not commit the farm's precise location to a public repository.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION_LABEL=Farm
WEATHER_REFRESH_SECONDS=1800

